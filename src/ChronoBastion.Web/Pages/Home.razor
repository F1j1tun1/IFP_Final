@page "/"
@implements IAsyncDisposable
@inject GameSession Session
@inject BrowserHighScoreStore Records
@inject IJSRuntime JS
<PageTitle>Thornwatch</PageTitle>
<div class="game-theme theme-@RegionArt.Key(region)" data-region="@RegionArt.Key(region)">
<div class="app-shell">
    <header class="topbar"><button class="brand" aria-label="Thornwatch home" @onclick="ShowMenu"><span class="brand-mark">♜</span> THORN<span>WATCH</span></button><span class="edition">GUARDIANS OF THE OLD ROAD</span><div class="header-actions"><button aria-pressed="@sound" @onclick="ToggleSound">Sound @(sound ? "on" : "off")</button><button @onclick="OpenHelp">Field manual</button></div></header>
    <main>
        @if (menu)
        {
            <MainMenu Stage="region" Ready="@(ready && !storageConflict)" CanContinue="hasRun" SaveLabel="@SaveLabel" RecordLabel="@RecordLabel" OnPlay="RequestNew" OnContinue="Continue" OnHelp="OpenHelp" />
        }
        else
        {
            <div class="mission-heading"><div><p class="eyebrow">CHAPTER @(Session.State.StageNumber.ToString("00")) / THE THORNWATCH CAMPAIGN</p><h1>@Chapter.Name</h1></div><span class="phase">@(Session.State.IsPaused ? "PAUSED" : Session.State.Phase == GamePhase.StageCleared ? "REGION SECURED" : Session.State.Phase.ToString().ToUpperInvariant())</span></div>
            <GameHud State="Session.State" />
            <div class="game-layout"><section class="battle-section" aria-label="Battle controls">
                <GameBoard State="Session.State" SelectedPad="selectedPad" OnSelect="Select" Effects="effects" Bursts="bursts" />
                <nav class="mobile-pad-list" aria-label="Select a build pad">
                    @foreach (var pad in Chapter.Map.Pads) { <button aria-label="Select pad @pad.Id" aria-pressed="@(selectedPad == pad.Id)" @onclick="() => Select(pad.Id)">@pad.Id</button> }
                </nav>
                <div class="battle-toolbar"><div class="wave-brief">
                    @if (Session.State.Phase == GamePhase.Planning) { <strong>@PlanningLabel</strong><span>@UpcomingWave</span> }
                    else if (Session.State.Phase == GamePhase.StageCleared) { <strong>Road secured. The journey continues.</strong><span>Your remaining health and gold travel with you.</span> }
                    else { <strong>@(Session.State.IsPaused ? "Defenders on hold" : "Protect the gate")</strong><span>@Session.State.Enemies.Length active · @Session.State.PendingEnemies incoming</span> }
                </div><div class="battle-actions">
                    @if (Session.State.Phase == GamePhase.Planning) { <button class="primary" @onclick="() => Dispatch(new GameCommand.StartWave())">Start wave @(Session.State.WaveInStage + 1) →</button> }
                    else if (Session.State.Phase == GamePhase.Combat) { <button class="primary" @onclick="() => Dispatch(new GameCommand.SetPaused(!Session.State.IsPaused))">@(Session.State.IsPaused ? "Resume" : "Pause")</button> }
                    @if (Session.State.HasCountdown) { <button @onclick="() => Dispatch(new GameCommand.SetPaused(!Session.State.IsPaused))">@(Session.State.IsPaused ? "Resume countdown" : "Pause countdown")</button> }
                    <button disabled="@Session.State.IsFinished" aria-pressed="@Session.State.AutoWaves" @onclick="() => Dispatch(new GameCommand.SetAutoWaves(!Session.State.AutoWaves))">Auto waves: @(Session.State.AutoWaves ? "On" : "Off")</button>
                    <button disabled="@(Session.State.IsFinished || Session.State.Phase == GamePhase.StageCleared)" aria-label="Speed x@(Session.State.SpeedMultiplier)" @onclick="() => Dispatch(new GameCommand.SetSpeed(Session.State.SpeedMultiplier == 1 ? 2 : 1))">×@Session.State.SpeedMultiplier</button>
                </div></div>
                <p class="announcement" role="status">@if (notice.Contains("gold", StringComparison.OrdinalIgnoreCase)) { <CoinIcon /> }@notice</p>
                <div class="secondary-actions"><button @onclick="RequestNew">Restart journey</button><button @onclick="ShowMenu">Save &amp; menu</button><span>@saveStatus</span></div>
            </section><TowerPanel State="Session.State" SelectedPad="selectedPad" OnCommand="Dispatch" Error="@error" /></div>
        }
        @if (Records.Warning is { } warning) { <p role="status" class="storage-warning">@warning</p> }
        @if (browserWarning is not null) { <p role="status" class="storage-warning">@browserWarning</p> }
        @if (storageConflict) { <button @onclick="Reload">Reload journey</button> }
    </main>
    <footer><span>THORNWATCH</span><span>THREE REGIONS. ONE JOURNEY. YOUR DEFENCE.</span></footer>
</div>
@if (help) { <HelpDialog OnClose="() => help = false" /> }
@if (confirmation)
{
    <div class="modal-backdrop"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title" tabindex="-1" data-dialog>
        <p class="eyebrow">LEAVE THIS JOURNEY BEHIND</p><h2 id="confirm-title">Begin again?</h2><p>Your saved attempt will be replaced. Start in the forest with <CoinIcon />300 gold and <HealthIcon />20 gate health. Your best record stays.</p>
        <button class="primary wide" @onclick="NewGame">Restart from the forest</button><button class="wide" @onclick="() => confirmation = false">Keep this journey</button>
    </section></div>
}
@if (!menu && Session.State.Phase == GamePhase.StageCleared && !help && !confirmation)
{
    <div class="modal-backdrop"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="chapter-title" tabindex="-1" data-dialog>
        <p class="eyebrow">CHAPTER @Session.State.StageNumber COMPLETE</p><h2 id="chapter-title">The road is yours.</h2><p>Next: @Campaign.Get(Session.State.StageNumber + 1).Name</p>
        <dl class="stats"><div><dt>Health carried</dt><dd class="health-value"><HealthIcon />@Session.State.CoreHealth / 20</dd></div><div><dt>Tower travel refund</dt><dd class="money"><CoinIcon />+@Session.State.Towers.Sum(GameRules.TravelRefund) gold</dd></div><div><dt>Region reward</dt><dd class="money"><CoinIcon />+@GameRules.RegionBonus gold</dd></div></dl>
        <p>Your defenders return home. Build a new line on the next map.</p><button class="primary wide" @onclick="() => Dispatch(new GameCommand.NextStage())">Travel to next region →</button><button class="wide" @onclick="ShowMenu">Save &amp; menu</button>
    </section></div>
}
@if (!menu && Session.State.IsFinished && !help && !confirmation)
{ <ResultDialog State="Session.State" RecordLabel="@RecordLabel" OnPlayAgain="NewGame" OnMenu="ShowMenu" /> }

</div>
@code {
    private int region = 1;
    private int? selectedPad;
    private string? error, browserWarning;
    private string notice = "Select a clearing and build your first defence.";
    private string saveStatus = "Autosave ready";
    private bool menu = true, ready, help, confirmation, disposed, hasRun, sound, hidden, storageConflict;
    private readonly CancellationTokenSource stop = new();
    private readonly System.Diagnostics.Stopwatch clock = System.Diagnostics.Stopwatch.StartNew();
    private readonly List<ShotEffect> effects = [];
    private readonly List<BurstEffect> bursts = [];
    private long effectId;
    private Task? loop;
    private Task persistence = Task.CompletedTask;
    private IJSObjectReference? module, visibility, dialogs;
    private DotNetObjectReference<Home>? reference;
    private Chapter Chapter => Campaign.Get(Session.State.StageNumber);
    private string ResumeInstruction => Session.State.Phase switch
    {
        GamePhase.Combat => "Choose Resume when ready.",
        GamePhase.StageCleared => "Travel to the next region when ready.",
        GamePhase.Planning => "Choose Start wave when ready.",
        _ => "Start a new journey to play again."
    };
    private string SaveLabel => $"{Chapter.Name} · wave {Session.State.WaveInStage}/{Session.State.StageWaves} · {ResumeInstruction}";
    private string PlanningLabel => Session.State.HasCountdown
        ? $"Next wave in {(Session.State.AutoWaveTicksRemaining + GameRules.TicksPerSecond - 1) / GameRules.TicksPerSecond}s{(Session.State.IsPaused ? " · paused" : "") }"
        : $"Wave {Session.State.WaveInStage + 1} approaching";
    private string RecordLabel => Records.Record.Match(r => $"{r.Score.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} points · {r.WavesCleared}/39 waves", () => "Your legend begins here");
    private string UpcomingWave => string.Join(" · ", WavePlanner.Schedule(Session.State.WaveNumber + 1).GroupBy(s => s.Kind).Select(g => $"{g.Count()} {EnemyCatalog.Get(g.Key).Name}"));

    protected override void OnInitialized() => Session.Updated += Updated;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Records.LoadAsync();
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser.js");
            region = await module.InvokeAsync<int>("readRegion");
            reference = DotNetObjectReference.Create(this);
            var storage = await module.InvokeAsync<string>("claimRun", reference);
            if (storage == "conflict") StorageConflict();
            else if (storage == "unavailable") browserWarning = "Journey storage is unavailable. Keep this tab open to play; progress cannot be saved.";
            visibility = await module.InvokeAsync<IJSObjectReference>("watchVisibility", reference);
            dialogs = await module.InvokeAsync<IJSObjectReference>("watchDialogs");
            try
            {
                var json = await JS.InvokeAsync<string?>("localStorage.getItem", SavedRuns.StorageKey);
                if (!storageConflict && storage == "ready" && !string.IsNullOrWhiteSpace(json) && json != "ended")
                    Session.Restore(json).Match(_ => { hasRun = true; return true; }, message => { browserWarning = message; return false; });
                else if (!storageConflict && json is null && await JS.InvokeAsync<string?>("localStorage.getItem", "thornwatch.run.v1") is { } old && old != "ended")
                    browserWarning = "The campaign balance has changed. Start a new journey; your best record is kept.";
            }
            catch (JSException) { browserWarning = "Journey storage is unavailable. Keep this tab open to play; progress cannot be saved."; }
        }
        catch (JSException) { browserWarning = "Browser integration is unavailable. Pause before leaving this tab."; }
        if (disposed) return;
        if (hasRun) SetRegion(Session.State.StageNumber);
        ready = true;
        loop = RunClockAsync();
        StateHasChanged();
    }
    private void SetRegion(int stage)
    {
        if (region == stage) return;
        region = stage;
        if (module is IJSInProcessObjectReference browser) browser.InvokeVoid("rememberRegion", region);
    }
    private void Select(int pad) { selectedPad = pad; error = null; }
    private void Dispatch(GameCommand command)
    {
        if (storageConflict || hidden) return;
        error = Session.Dispatch(command).Match(_ => (string?)null, e => e.Message);
        FlushSave();
    }
    private void RequestNew() { if (storageConflict) return; if (hasRun) { Pause(); confirmation = true; } else NewGame(); }
    private void NewGame() { if (storageConflict) return; hasRun = true; Dispatch(new GameCommand.Restart()); menu = false; }
    private void Continue() { if (hasRun && !storageConflict) { menu = false; notice = ResumeInstruction; } }
    private void ShowMenu() { if (!ready) return; Pause(); FlushSave(); menu = true; }
    private void Pause() { if (!Session.State.IsFinished) Session.Dispatch(new GameCommand.Suspend()); }
    private void OpenHelp() { Pause(); help = true; }
    private async Task ToggleSound()
    {
        if (module is null) return;
        try { sound = await module.InvokeAsync<bool>("setSound", !sound); }
        catch (JSException) { browserWarning = "Audio is unavailable in this browser. Gameplay is unaffected."; }
    }
    [JSInvokable] public Task OnVisibilityChanged(bool isHidden) => InvokeAsync(() =>
    {
        hidden = isHidden;
        if (hidden) { Pause(); FlushSave(); notice = $"{saveStatus}. {ResumeInstruction}"; }
        StateHasChanged();
    });
    [JSInvokable] public Task OnStorageConflict() => InvokeAsync(() => { StorageConflict(); StateHasChanged(); });
    private void StorageConflict()
    {
        storageConflict = true;
        Pause();
        browserWarning = "Journey storage is in use or changed in another tab. Close the other game tab, then reload here.";
        saveStatus = "Saving stopped: another tab owns the journey";
    }
    private async Task Reload() { if (module is not null) await module.InvokeVoidAsync("reload"); }
    private void CacheSave(GameState state)
    {
        // WASM's synchronous adapter keeps an in-memory snapshot ready for pagehide.
        // Disk writes happen on actions, every two seconds and when leaving the tab.
        if (storageConflict || !hasRun && !state.IsFinished || module is not IJSInProcessObjectReference browser) return;
        try { browser.InvokeVoid("cacheRun", state.IsFinished ? "ended" : SavedRuns.Serialize(state)); }
        catch (JSException) { browserWarning = "Journey storage is unavailable. Keep this tab open to continue."; }
    }
    private void FlushSave()
    {
        if (module is not IJSInProcessObjectReference browser) return;
        try
        {
            var status = browser.Invoke<string>("flushRun");
            if (status == "conflict") { StorageConflict(); return; }
            saveStatus = status switch { "saved" => "Journey saved on this device", "idle" => "No journey to save", _ => "Autosave unavailable" };
        }
        catch (JSException) { saveStatus = "Autosave unavailable"; }
        if (saveStatus == "Autosave unavailable") browserWarning = "Your journey cannot be saved on this device. Keep this tab open to continue.";
    }
    private void PlaySound(string kind)
    {
        if (!sound || module is not IJSInProcessObjectReference browser) return;
        try { browser.InvokeVoid("playCue", kind); } catch (JSException) { sound = false; }
    }
    private void Updated(GameTransition transition)
    {
        if (hasRun || transition.State.IsFinished) SetRegion(transition.State.StageNumber);
        CacheSave(transition.State);
        foreach (var item in transition.Events)
        {
            switch (item)
            {
                case GameEvent.ShotFired shot:
                    effects.Add(new(++effectId, Chapter.Map.Pads.First(p => p.Id == shot.PadId).Position, shot.Target, shot.Kind, clock.Elapsed + TimeSpan.FromMilliseconds(180)));
                    PlaySound(shot.Kind.ToString());
                    break;
                case GameEvent.TowerBuilt built: notice = $"{TowerCatalog.Get(built.Kind).Name} deployed on pad {built.PadId}."; PlaySound("build"); break;
                case GameEvent.EnemyKilled killed: bursts.Add(new(++effectId, killed.Position, clock.Elapsed + TimeSpan.FromMilliseconds(220))); break;
                case GameEvent.Summoned: notice = "The War Chief has summoned goblin reinforcements!"; PlaySound("boss"); break;
                case GameEvent.TowerUpgraded upgraded: notice = $"Pad {upgraded.PadId} upgraded to level {upgraded.Level}."; PlaySound("build"); break;
                case GameEvent.TowerSold sold: notice = $"Defence sold for {sold.Refund} gold."; break;
                case GameEvent.WaveStarted: notice = $"Wave {Session.State.WaveInStage} incoming."; PlaySound("wave"); break;
                case GameEvent.WaveCleared cleared: notice = $"Wave cleared. +{cleared.Gold} gold · +{cleared.Points} points."; FlushSave(); break;
                case GameEvent.StageEntered entered:
                    selectedPad = null; effects.Clear(); bursts.Clear(); error = null;
                    notice = $"Arrived at {Chapter.Name}. +{entered.Refund} gold refund and +{entered.Bonus} gold region reward.";
                    break;
                case GameEvent.GameEnded:
                    hasRun = false; FlushSave(); PlaySound(transition.State.Phase == GamePhase.Won ? "win" : "loss");
                    persistence = SaveRecordAsync(persistence, transition.State);
                    break;
                case GameEvent.GameRestarted:
                    effects.Clear(); bursts.Clear(); selectedPad = null; error = null; confirmation = false; help = false;
                    notice = "A new journey. Select a clearing and prepare your defences.";
                    break;
            }
        }
        if (effects.Count > 100) effects.RemoveRange(0, effects.Count - 100);
        if (bursts.Count > 50) bursts.RemoveRange(0, bursts.Count - 50);
        StateHasChanged();
    }
    private async Task SaveRecordAsync(Task previous, GameState finished)
    {
        await previous;
        await Records.SaveFinishedAsync(finished);
        if (!disposed) await InvokeAsync(StateHasChanged);
    }
    private async Task RunClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        var previous = clock.Elapsed;
        var nextSave = clock.Elapsed + TimeSpan.FromSeconds(2);
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(() =>
                {
                    var now = clock.Elapsed;
                    var removed = effects.RemoveAll(e => e.Expires <= now) + bursts.RemoveAll(e => e.Expires <= now);
                    if (!menu && !help && !confirmation && !hidden && !storageConflict) Session.Advance(now - previous);
                    previous = now;
                    if (now >= nextSave && hasRun) { FlushSave(); nextSave = now + TimeSpan.FromSeconds(2); }
                    if (removed > 0) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Session.Updated -= Updated;
        stop.Cancel();
        if (loop is not null) await loop;
        FlushSave();
        await persistence;
        foreach (var listener in new[] { visibility, dialogs })
        {
            if (listener is null) continue;
            try { await listener.InvokeVoidAsync("dispose"); await listener.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("releaseRun"); await module.InvokeVoidAsync("disposeAudio"); await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        stop.Dispose();
    }
}
