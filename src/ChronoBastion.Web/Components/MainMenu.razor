<section class="main-menu">
    <div class="menu-copy"><p class="eyebrow">A FANTASY TOWER DEFENCE</p>
        <h1>Defend the<br /><em>old road.</em></h1>
        <p class="intro">Protect three regions against 39 waves of enemies.</p>
        @if (CanContinue) { <button class="primary play" disabled="@(!Ready)" @onclick="OnContinue">Continue journey →</button><p class="save-note">@SaveLabel</p> }
        <button class="@(CanContinue ? "wide new-journey" : "primary play")" disabled="@(!Ready)" @onclick="OnPlay">@(Ready ? "New journey →" : "Loading game…")</button>
        <button class="text-button" @onclick="OnHelp">How to play</button>
        <div class="record"><span>BEST COMPLETED RUN</span><strong>@RecordLabel</strong><small>Saved in this browser.</small></div>
    </div>
    <div class="menu-art" aria-hidden="true">
<div class="menu-landscape"><svg viewBox="0 0 600 500">
            <image href="@RegionArt.Map(Stage)" width="600" height="500" preserveAspectRatio="xMaxYMid slice" />
            <g class="menu-guardian"><UnitSprite Tower="TowerKind.Pulse" Level="3" X="72" Y="210" Size="104" /></g>
            <g class="menu-guardian"><UnitSprite Tower="TowerKind.Frost" Level="3" X="294" Y="145" Size="100" /></g>
            <g class="menu-guardian"><UnitSprite Tower="TowerKind.Mortar" Level="2" X="414" Y="345" Size="96" /></g>
            <UnitSprite Enemy="EnemyKind.Grunt" X="180" Y="365" Size="46" />
            <UnitSprite Enemy="EnemyKind.Wolf" X="345" Y="280" Size="46" />
        </svg></div><span class="art-caption">@Campaign.Get(Stage).Name.ToUpperInvariant() <b>CHAPTER @(Stage == 1 ? "I" : Stage == 2 ? "II" : "III")</b></span>
    </div>
</section>
<div class="chapter-cards">
    @foreach (var chapter in Campaign.Chapters)
    { <article class="@(chapter.Number == Stage ? "active" : "")"><span>@(chapter.Number.ToString("00")) / @chapter.Waves WAVES</span><h2>@chapter.Name</h2><p>@chapter.Subtitle</p></article> }
</div>
@code {
    [Parameter] public int Stage { get; set; } = 1;
    [Parameter] public bool Ready { get; set; }
    [Parameter] public bool CanContinue { get; set; }
    [Parameter] public string SaveLabel { get; set; } = "Journey saved";
    [Parameter] public string RecordLabel { get; set; } = "No completed journeys";
    [Parameter] public EventCallback OnPlay { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnHelp { get; set; }
}
