<rect width="960" height="540" fill="@(Stage == 1 ? "#54794b" : Stage == 2 ? "#73735a" : "#615d55")" />
<defs><pattern id="ground-dots" width="37" height="37" patternUnits="userSpaceOnUse"><path d="M6 21l3-5 2 4M25 8h3" fill="none" stroke="#253b32" opacity=".17" stroke-width="2"/></pattern></defs>
<rect width="960" height="540" fill="url(#ground-dots)" />
@foreach (var point in decorations)
{
    <g transform="translate(@point.X @point.Y)" aria-hidden="true">
        @if (Stage == 1)
        {
            <ellipse cy="13" rx="28" ry="20" fill="#273e2a" opacity=".4"/>
            <path d="M-22 10Q-36-6-18-17Q-19-39 1-32Q20-41 24-19Q40-6 24 12Q4 29-22 10" fill="@(point.X % 2 == 0 ? "#254e38" : "#326347")" stroke="#203c30" stroke-width="3"/>
            <path d="M-19-10Q-12-27 0-23Q17-31 21-12Q1 0-19-10" fill="#688c43"/>
        }
        else if (Stage == 2 && point.X % 3 != 0)
        {
            <path d="M-26-22H22V26H-26Z" fill="#c5ad82" stroke="#414a3d" stroke-width="3"/>
            <path d="M-32-25H27V-2L6 3-2-7-13 2H-32Z" fill="#815c45" stroke="#3f4135" stroke-width="3"/>
            <path d="M-28-18H24M-28-10H-9M10 8h7v10H10" fill="none" stroke="#d0a26f" stroke-width="3"/>
            <path d="M-18 14l8 6-12 5M24 28l10 3-4 8" fill="#999b8d" stroke="#464e44" stroke-width="2"/>
        }
        else if (Stage == 3 && point.X % 3 != 0)
        {
            <rect x="-24" y="-24" width="48" height="48" rx="5" fill="#3a4141" stroke="#202f2b" stroke-width="4"/>
            <path d="M-20-22h12v10h-12ZM8-22h12v10H8ZM-20 12h12v10h-12ZM8 12h12v10H8Z" fill="#919184" stroke="#303c37" stroke-width="2"/>
            <path d="M-4-13H18L11-1l7 10H-4Z" fill="#bb6047" stroke="#452f29" stroke-width="2"/>
            <path d="M-4-17V21" stroke="#d2ba78" stroke-width="3"/>
        }
        else
        { <path d="M-20 9-14-12 5-18 24-2 16 16-7 21Z" fill="#979988" stroke="#465546" stroke-width="3"/><path d="M-14-12 4-5 24-2M4-5-7 21" fill="none" stroke="#6e7969" stroke-width="2"/> }
    </g>
}
@code {
    [Parameter] public int Stage { get; set; } = 1;
    private int previousStage;
    private List<Position> decorations = [];
    protected override void OnParametersSet()
    {
        if (previousStage == Stage) return;
        previousStage = Stage;
        decorations.Clear();
        var map = Campaign.Get(Stage).Map;
        for (var y=32; y<540; y+=78)
        for (var x=28; x<930; x+=83)
        {
            var p=new Position(x + (y/78%2)*17, y);
            if (map.Pads.Any(pad=>pad.Position.DistanceSquaredTo(p)<4000)) continue;
            if (Enumerable.Range(0,(int)map.Length/20+1).Any(i=>map.PositionAt(i*20).DistanceSquaredTo(p)<3900)) continue;
            decorations.Add(p);
        }
    }
}
